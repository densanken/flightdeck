# GitHub App の App ID
# https://github.com/settings/apps または organization settings の GitHub Apps から取得してください
GITHUB_APP_ID=

# GitHub App の private key
# 手動で設定する場合は PKCS#8 (BEGIN PRIVATE KEY) 形式にし、改行を \n へ置換して 1 行で記述してください
# PEM ファイルからの変換方法は README の「秘密鍵（Private Key）の変換」を参照
GITHUB_APP_PRIVATE_KEY=

# GitHub App の Webhook Secret
# GitHub App 設定の Webhook secret と同じ値を指定してください
# 生成コマンド: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# dispatch App の bot の数値 user ID
# gh api 'users/<dispatch App の slug>[bot]' の id を指定してください
DISPATCH_BOT_USER_ID=

# Renovate の bot の数値 user ID（29139614 は Mend が提供する Renovate の GitHub App の renovate[bot]）
# self-hosted Renovate はその bot の ID に置き換えるか、カンマ区切りで追加してください
RENOVATE_BOT_USER_IDS=29139614

# clearance App の bot の数値 user ID
# gh api 'users/<clearance App の slug>[bot]' の id を指定してください
CLEARANCE_BOT_USER_ID=
