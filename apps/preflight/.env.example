# GitHub App の App ID
# https://github.com/settings/apps または organization settings の GitHub Apps から取得してください
GITHUB_APP_ID=

# GitHub App の private key
# 手動で設定する場合は PKCS#8 (BEGIN PRIVATE KEY) 形式にし、改行を \n へ置換して 1 行で記述してください
# PEM ファイルからの変換方法は README の「Private key」を参照
GITHUB_PRIVATE_KEY=

# GitHub App の Webhook Secret
# GitHub App 設定の Webhook secret と同じ値を指定してください
# 生成コマンド: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# GitHub App の bot アカウント `<APP_SLUG>[bot]` の数値 user ID
# App ID や installation ID ではありません
# 自身が投稿したタイトル説明コメントの判別に使用します
# Webhook の処理時に GitHub から取得した bot user ID と照合し、一致しない場合はタイトル検証を失敗として扱います
# 取得方法は README の「App Bot user ID」を参照し、response の `id` を指定してください
GITHUB_APP_BOT_USER_ID=

# 同一 delivery の重複処理を抑止する Cache API entry の TTL (秒)
# 同じ delivery が再配信されても処理を重複させない期間を指定してください
# この行を削除した場合の default: 86400
DELIVERY_CACHE_TTL_SECONDS=86400

# Bot が作成した PR の auto-assign をスキップするか (true / false)
# この行を削除した場合の default: true
SKIP_BOTS=true

# 出力する最小ログレベル (debug / info / warn / error)
# この行を削除した場合の default: info
LOG_LEVEL=debug
