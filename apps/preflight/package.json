{
  "name": "preflight",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "pnpm typecheck && wrangler deploy --dry-run --config wrangler.jsonc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "pnpm typecheck && eslint --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "set-github-private-key": "tsx scripts/set-github-private-key.ts"
  },
  "dependencies": {
    "@flightdeck/github-app-jwt": "workspace:*",
    "@flightdeck/logger": "workspace:*",
    "@flightdeck/pr-title": "workspace:*",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@flightdeck/private-key-env": "workspace:*"
  }
}
