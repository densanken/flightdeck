# GitHub App の App ID
# https://github.com/settings/apps または organization settings の GitHub Apps から取得してください
GITHUB_APP_ID=

# GitHub App の private key
# 手動で設定する場合は PKCS#8 (BEGIN PRIVATE KEY) 形式にし、改行を \n へ置換して 1 行で記述してください
# PEM ファイルからの変換方法は README の「Private key」を参照
GITHUB_APP_PRIVATE_KEY=

# merge 対象 repository を所有する GitHub organization の login
# この organization 配下の repository だけを登録し、操作できます
GITHUB_ORG=

# Discord Interactions Endpoint Bot 用の公開鍵
# https://discord.com/developers/applications のアプリケーション設定から取得してください
DISCORD_PUBLIC_KEY=

# Discord Application ID
# slash command の応答とコマンド登録に使用します
DISCORD_APPLICATION_ID=

# Discord Bot Token
# pnpm run register-commands でのコマンド登録だけに使用します
# Worker の実行には不要なため、Cloudflare Secret には登録しません
DISCORD_BOT_TOKEN=

# アクセスを許可する Discord guild (サーバー) の ID (カンマ区切り)
# ここに指定した guild のメンバーだけが Discord command を利用できます
ALLOWED_GUILD_IDS=

# repository の登録と削除を許可する Discord role ID (カンマ区切り)
# /repo add と /repo remove の実行に必要です
ADMIN_ROLE_IDS=

# merge 成功時の監査通知を送信する Discord Webhook URL (https)
MERGE_AUDIT_DISCORD_WEBHOOK_URL=

# Worker 自身の環境固有 origin (例: ローカルは http://localhost:8787、本番は https://takeoff.example.com)
# 全 Cache API key の namespace に使用します
# production と staging には、Cloudflare Dashboard で各 Worker へ割り当てた異なる custom domain を指定してください
PUBLIC_BASE_URL=http://localhost:8787

# open PR 一覧 cache の TTL (秒)
# この行を削除すると既定値を使います
# 空にすると無効な値として拒否されます
PR_LIST_CACHE_TTL_SECONDS=60

# repository index cache の TTL (秒)
# Cache API は colo local で他拠点への invalidate が届かないため、この値がそのまま
# 他拠点へ repo の追加と削除が反映されるまでの遅延の上限になります
# この行を削除すると既定値を使います
# 空にすると無効な値として拒否されます
REPO_INDEX_CACHE_TTL_SECONDS=300

# 同一 PR への merge 連打を抑制する cooldown (秒)
# この行を削除すると既定値を使います
# 空にすると無効な値として拒否されます
MERGE_COOLDOWN_SECONDS=10

# 同一 repository への sync 連打を抑制する cooldown (秒)
# この行を削除すると既定値を使います
# 空にすると無効な値として拒否されます
SYNC_COOLDOWN_SECONDS=30

# /repo add 用 repository 候補 cache の TTL (秒)
# この行を削除すると既定値を使います
# 空にすると無効な値として拒否されます
INSTALLATION_REPO_CACHE_TTL_SECONDS=60

# GitHub App の Webhook Secret
# GitHub App 設定の Webhook secret と同じ値を指定してください
# 生成コマンド: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
