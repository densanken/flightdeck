{
  "name": "flightdeck",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --filter './apps/*' --workspace-concurrency=1 run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "pnpm typecheck && eslint --fix && prettier --write .",
    "lint:check": "pnpm typecheck && eslint",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "pnpm --recursive --if-present --workspace-concurrency=1 run test"
  },
  "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@eslint/js": "^10.0.1",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^26.6.1",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.133.0"
  }
}
